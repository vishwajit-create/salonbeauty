import { Controller, Get, Query, Req, Post, Body, UseGuards } from '@nestjs/common';
import { UploadService } from './upload.service';
import { RolesGuard } from '../common/roles.guard';
import { Roles } from '../common/roles.decorator';

@Controller('upload')
export class UploadController {
  constructor(private readonly uploadService: UploadService) {}

  @Get('presign')
  async presign(@Req() req: any, @Query('salonId') salonId: string, @Query('filename') filename: string, @Query('contentType') contentType: string) {
    if (!req.user) return { ok: false, message: 'Unauthorized' };
    try {
      const data = await this.uploadService.getPresignedPutUrl(salonId, filename, contentType);
      return { ok: true, ...data };
    } catch (e: any) {
      return { ok: false, message: e.message };
    }
  }

  @Get('presign-post')
  async presignPost(@Req() req: any, @Query('salonId') salonId: string, @Query('filename') filename: string, @Query('contentType') contentType: string) {
    if (!req.user) return { ok: false, message: 'Unauthorized' };
    try {
      const data = await this.uploadService.getPresignedPost(salonId, filename, contentType);
      return { ok: true, ...data };
    } catch (e: any) {
      return { ok: false, message: e.message };
    }
  }

  @Get('presigned-get')
  async presignedGet(@Req() req: any, @Query('key') key: string) {
    if (!req.user) return { ok: false, message: 'Unauthorized' };
    try {
      const url = await this.uploadService.getPresignedGet(key);
      return { ok: true, url };
    } catch (e: any) {
      return { ok: false, message: e.message };
    }
  }
}
